# 复制为 .env 并填写（.env 不入库）。所有项均有缺省行为。

# 内置管理员账号（admin / admin@shiti.local）的初始密码；首次启动后可删除此行。
# 不设置时，服务会随机生成密码并写入数据目录下的 admin-credentials.txt。
SHITI_ADMIN_PASSWORD=

# 数据目录（缺省：%LOCALAPPDATA%\ShitiWorkbench\workspaces\default）
# SHITI_DATA_DIR=

# 题库目录（缺省：仓库根的 question_bank/）
# SHITI_BANK_DIR=

# 监听端口（缺省 8210）
# SHITI_PORT=
